# 多 Agent 智能旅行规划系统 —— 环境变量模板
#
# 用法：cp .env.example .env，然后填上真实值。
# `.env` 已被 .gitignore 拦截，**永远不要提交**（硬红线 #6）。
#
# 变量全表见 docs/方案设计.md §12。下面只标注推荐值，默认值以方案设计为准。

# ============================================================================
# LLM —— 唯一必填项，其余留空即用默认值
# ============================================================================
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# 三个模型槽位按节点角色分档（方案设计 §12）：
#   主力模型：行程生成 / 反思审核 —— 决定质量
#   便宜模型：需求收集 —— 纯结构化抽取，简单任务
#   评估模型：LLM-as-Judge —— 配 temperature=0
LLM_MODEL=deepseek-v4-flash
LLM_MODEL_CHEAP=deepseek-v4-flash
LLM_JUDGE_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ============================================================================
# 循环闸门（方案设计 §5.2）
# ============================================================================
MAX_REVIEW_RETRY=3      # G1 机器自省上限，超限降级放行
MAX_USER_REVISION=5     # G2 用户修改上限
MAX_ASK_ROUNDS=3        # G3 追问轮数上限，超限填默认值继续

# ============================================================================
# 工具与数据源
# ============================================================================
PLAN_TOOL_MODE=deterministic   # deterministic（默认，节点代码调工具）/ agent（LLM 自主调）

# 数据源**按数据域分别选**，不用一个全局开关。理由见方案设计 §6.4：
# 单个全局值表达不了「POI 用高德、酒店用 AIGOHOTEL」这种组合。
POI_BACKEND=mock               # mock / amap        景点查询 + 开放时间
DISTANCE_BACKEND=mock          # mock / amap        距离估算
HOTEL_BACKEND=mock             # mock / aigohotel   酒店价格
INTERCITY_BACKEND=mock         # mock / variflight  城际交通（契约未定义，仅预留开关）

# 密钥：只在该域被选中时才需要，后端与密钥不配套会在启动时直接失败。
AMAP_API_KEY=                  # 任一域切 amap 时必填
AIGOHOTEL_API_KEY=             # HOTEL_BACKEND=aigohotel 时必填
VARIFLIGHT_API_KEY=            # INTERCITY_BACKEND=variflight 时必填

TOOL_TIMEOUT=5
POI_DATA_PATH=data/poi_clean.json
SQLITE_PATH=data/app.db
# 置 true 时**所有域被强制短路成 mock**（Settings.effective_backend），
# 只留 LLM 一条真实依赖。演示防翻车 + 评估可复现（无网络抖动）用。
DEMO_MODE=false

# ============================================================================
# 服务
# ============================================================================
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=                  # 逗号分隔，留空 = 仅同源
SESSION_TTL_DAYS=30
AUTH_REQUIRED=false            # 公网部署前开启
AUTH_TOKEN=                    # AUTH_REQUIRED=true 时必填，长度 < 16 直接启动失败
LOG_LEVEL=INFO
LOG_FORMAT=text                # text / json
AUTO_APPROVE=false             # 批量评估时自动通过 HITL
